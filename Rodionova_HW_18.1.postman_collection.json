		{
			"name": "Book ISBN Numbers",
			"item": [
				{
					"name": "Is Valid ISBN13 Number",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const raw = pm.response.text();\r",
									"const ct = pm.response.headers.get('Content-Type') || '';\r",
									"\r",
									"// Базові перевірки\r",
									"pm.test('200 OK', () => pm.response.to.have.status(200));\r",
									"pm.test('Content-Type = text/xml (SOAP 1.1)', () =>\r",
									"  pm.expect(ct).to.include('text/xml')\r",
									");\r",
									"pm.test('Envelope/Body присутній', () => {\r",
									"  pm.expect(raw).to.match(/<(\\w+:)?Envelope/i);\r",
									"  pm.expect(raw).to.match(/<(\\w+:)?Body/i);\r",
									"});\r",
									"pm.test('Немає SOAP Fault', () =>\r",
									"  pm.expect(raw).to.not.match(/<(\\w+:)?Fault/i)\r",
									");\r",
									"\r",
									"// Перевірка результату true/false\r",
									"pm.test('Є IsValidISBN*Result', () => {\r",
									"  pm.expect(raw).to.match(/<(\\w+:)?IsValidISBN(10|13)Result>(true|false)<\\/\\1?IsValidISBN(10|13)Result>/i);\r",
									"});\r",
									"\r",
									"// Час відповіді\r",
									"pm.test('Response time < 2000 ms', () =>\r",
									"  pm.expect(pm.response.responseTime).to.be.below(2000)\r",
									");\r",
									"\r",
									"// Заголовки сервера\r",
									"pm.test('Header Date присутній', () =>\r",
									"  pm.expect(pm.response.headers.has('Date')).to.be.true\r",
									");\r",
									"pm.test('Content-Length > 0 (якщо є)', () => {\r",
									"  const cl = pm.response.headers.get('Content-Length');\r",
									"  if (cl) pm.expect(Number(cl)).to.be.above(0);\r",
									"  else pm.expect(true).to.be.true;\r",
									"});\r",
									"\r",
									"pm.test(\"Відповідь не HTML (IIS error page)\", () => {\r",
									"  pm.expect(raw.slice(0, 200).toLowerCase()).to.not.match(/<!doctype|<html/i);\r",
									"});\r",
									"\r",
									"pm.test(\"Response size < 50KB\", () => {\r",
									"  pm.expect(raw.length).to.be.below(50 * 1024);\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"pm.request.headers.remove('Content-Type');\r",
